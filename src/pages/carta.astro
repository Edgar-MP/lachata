---
import Layout from "../layouts/Layout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Button from "../components/base/Button.astro";
import { Picture } from "astro:assets";
import entrantesImg from "../assets/platos/pulpo.webp";
import carnesImg from "../assets/platos/IMG_9166.webp";
import pescadosImg from "../assets/platos/IMG_7148.webp";
import postresImg from "../assets/platos/IMG_8590.webp";

const sections = [
	{
		title: "Entrantes",
		note: "Ración / ½ ración · ● Contiene gluten",
		image: entrantesImg,
		items: [
			{ name: "Jamón ibérico 75 % bellota", price: "25,50€ / 13,50€", desc: "" },
			{ name: "● Ensalada de calamares en tempura, AOVE y alioli ligero", price: "21,50€ / 12,00€", desc: "" },
			{ name: "Puerros frescos asados a la brasa con sal de Añana y salsa romescu", price: "19,50€", desc: "" },
			{ name: "● Rollitos crujientes de langostino y salsa de puerro", price: "16,00€", desc: "" },
			{ name: "● Croquetas caseras de puerro confitado o picadillo (6 uds.)", price: "15,00€", desc: "" },
			{ name: "● Lecherillas empanadas con alegría riojana", price: "21,00€ / 11,00€", desc: "" },
			{ name: "● Saquitos de morcilla y manzana asada con salsa de piquillos", price: "19,50€", desc: "" },
			{ name: "Vieiras a la plancha sobre papel de arroz frito y con salsa de mantequilla y lima", price: "24,50€", desc: "" },
			{ name: "Pulpo gallego a la brasa sobre parmentier y pimentón de la Vera", price: "31,50€ / 17,50€", desc: "" },
		],
	},
	{
		title: "Carnes",
		note: "Ración · ● Contiene gluten",
		image: carnesImg,
		items: [
			{ name: "Carrilleras ibéricas al vino tinto con boletus y foie fresco", price: "25,50€", desc: "" },
			{ name: "Solomillo de ternera con pimientos rojos asados y patatas fritas", price: "27,00€", desc: "" },
			{ name: "Chuletillas de cordero a la brasa con patatas baby asadas y pimientos del país", price: "26,50€", desc: "" },
			{ name: "● Albóndigas de chuletón con salsa española y patatas fritas", price: "23,50€", desc: "" },
		],
	},
	{
		title: "Pescados",
		note: "Ración · ● Contiene gluten",
		image: pescadosImg,
		items: [
			{ name: "Atún Balfegó con cebolla caramelizada y tomate cassé macerado en AOVE", price: "24,00€", desc: "" },
			{ name: "Calamar a la brasa con patata panadera", price: "23,50€", desc: "" },
			{ name: "Pescado fresco del día (consultar alérgenos)", price: "S/M", desc: "" },
			{ name: "Bacalao al horno con crema de espárragos trigueros, huevas de trucha y crujiente de su piel", price: "24,50€", desc: "" },
			{ name: "Mollete de pan", price: "1,10€", desc: "" },
		],
	},
	{
		title: "Postres",
		note: "● Contiene gluten",
		image: postresImg,
		items: [
			{ name: "● Sopa de frutos rojos con helado de queso de cabra y teja de almendra", price: "8,50€", desc: "" },
			{ name: "Tarta de queso al horno con frutos rojos", price: "7,00€", desc: "" },
			{ name: "● Goxua", price: "6,50€", desc: "" },
			{ name: "● Canutillo relleno de nata o crema con chocolate caliente", price: "7,00€", desc: "" },
			{ name: "Milhojas de tres chocolates", price: "8,00€", desc: "" },
			{ name: "Sorbete de mojito con ron (obrador Gratte)", price: "7,00€", desc: "" },
			{ name: "● Tartaleta de hojaldre con manzana, mermelada de albaricoque y crema inglesa", price: "7,00€", desc: "" },
			{ name: "Tabla de queso con nueces y membrillo", price: "8,50€", desc: "" },
			{ name: "Trufas de chocolate al vino blanco y vino tinto (obrador Kankel). 6 uds.", price: "10,00€", desc: "" },
		],
	},
];

const getPortionPrices = (price: string) => {
	const prices = price.split("/").map((value) => value.trim());
	if (prices.length !== 2 || !prices.every((value) => /\d/.test(value)))
		return null;

	return { full: prices[0], half: prices[1] };
};
---

<Layout
	title="Carta y Menú | Restaurante La Chata 1821, Logroño"
	description="Descubre la carta de La Chata 1821: cocina tradicional riojana con chuletillas de cordero a la brasa, carrilleras, bacalao, pulpo gallego y postres caseros, elaborados con producto de cercanía."
>
	<Header />

	<main class="bg-secondary pt-32">
		<!-- Menu Hero -->
		<section class="editorial-container py-24 relative overflow-hidden">
			<div
				class="absolute -top-24 -right-24 w-96 h-96 bg-primary/5 rounded-full blur-3xl pointer-events-none"
			>
			</div>

			<div class="max-w-4xl mx-auto text-center reveal-on-scroll">
				<span
					class="text-primary/40 font-sans text-xs uppercase tracking-[0.4em] mb-6 block"
					>La Selección</span
				>
				<h1
					class="text-primary font-heading text-6xl md:text-8xl leading-none mb-8"
				>
					Nuestra Carta
				</h1>
				<div class="w-24 h-px bg-primary/20 mx-auto mb-8"></div>
				<p
					class="text-primary/60 font-serif italic text-xl max-w-xl mx-auto leading-relaxed"
				>
					"Sabores de siempre, como nunca. Una selección honesta basada en el
					producto y la tradición desde 1821."
				</p>
				<p
					class="text-primary/30 font-sans text-[10px] uppercase tracking-[0.3em] mt-8"
				>
					Carta actualizada · Octubre 2026
				</p>
			</div>
		</section>

		<!-- Menu Sections -->
		<section class="pb-32">
			<div class="editorial-container">
				<div class="max-w-4xl mx-auto">
					<div class="space-y-32">
						{
							sections.map((section, sIdx) => (
								<section
									class="reveal-on-scroll"
									style={`transition-delay: ${sIdx * 0.1}s`}
								>
									<div class={`grid lg:grid-cols-12 gap-12 items-center ${sIdx % 2 !== 0 ? 'lg:flex-row-reverse' : ''}`}>
										<!-- Text Content -->
										<div class={`lg:col-span-7 ${sIdx % 2 !== 0 ? 'lg:order-2' : ''}`}>
											<div class="mb-16">
												<h2 class="text-primary font-heading text-4xl md:text-5xl mb-4 italic">
													{section.title}
												</h2>
												<p class="text-primary/40 font-sans text-xs uppercase tracking-widest">
													{section.note}
												</p>
											</div>

											<div class="grid gap-y-4">
												{section.items.map((item) => {
													const portionPrices = getPortionPrices(item.price);

													return (
													<div class="group py-8 px-6 border-b border-primary/5 hover:bg-primary/2 transition-all duration-500 relative">
														<!-- Vertical accent line -->
														<div class="absolute left-0 top-0 bottom-0 w-px bg-primary scale-y-0 group-hover:scale-y-100 transition-transform duration-500 origin-top" />

														<div class="flex justify-between items-end mb-4 group-hover:translate-x-2 transition-transform duration-500">
															<h3 class="text-primary font-heading text-2xl">
																{item.name}
															</h3>
															<div class="grow mx-4 h-px border-b border-dotted border-primary/10" />
															{
																portionPrices ? (
																	<div class="flex gap-2 text-primary font-sans">
																		<span class="inline-flex items-center gap-1 border border-primary/10 px-2 py-1">
																			<span class="text-[10px] uppercase tracking-widest text-primary/60">
																				R
																			</span>
																			<span class="font-bold text-base">
																				{portionPrices.full}
																			</span>
																		</span>
																		<span class="inline-flex items-center gap-1 border border-primary/10 px-2 py-1">
																			<span class="text-[10px] uppercase tracking-widest text-primary/60">
																				1/2
																			</span>
																			<span class="font-bold text-base">
																				{portionPrices.half}
																			</span>
																		</span>
																	</div>
																) : (
																	<span class="text-primary font-sans font-bold text-lg">
																		{item.price}
																	</span>
																)
															}
														</div>
														{item.desc ? (
															<p class="text-primary/60 font-sans text-sm leading-relaxed max-w-lg group-hover:translate-x-2 transition-transform duration-500">
																{item.desc}
															</p>
														) : null}
													</div>
													);
												})}
											</div>
										</div>

										<!-- Section Image -->
										<div class={`lg:col-span-5 ${sIdx % 2 !== 0 ? 'lg:order-1' : ''}`}>
											<div class="relative group">
												<div class="absolute -inset-4 border border-primary/5 -z-10 group-hover:-inset-6 transition-all duration-1000"></div>
												<div class="aspect-4/5 overflow-hidden bg-white shadow-2xl">
													<Picture
														src={section.image}
														alt={section.title}
														formats={["avif", "webp"]}
														fallbackFormat="webp"
														widths={[700, 1100]}
														sizes="(min-width: 1024px) 40vw, 100vw"
														pictureAttributes={{ class: "w-full h-full" }}
														class="w-full h-full object-cover grayscale-20 group-hover:grayscale-0 transition-all duration-[2s] group-hover:scale-105"
													/>
												</div>
											</div>
										</div>
									</div>
								</section>
							))
						}
					</div>

					<!-- Wine CTA -->
					<div class="mt-20 text-center reveal-on-scroll">
						<p class="text-primary/50 font-sans text-xs uppercase tracking-[0.3em] mb-8">
							Nuestra carta de vinos ya tiene su apartado propio
						</p>
						<Button
							href="/vinos"
							variant="ghost"
							class="px-10 py-3 border border-primary/20 text-primary hover:bg-primary hover:text-white transition-all duration-500"
						>
							VER CARTA DE VINOS
						</Button>
					</div>

					<!-- Bottom CTA -->
					<div class="mt-20 text-center reveal-on-scroll">
						<p class="text-primary/50 font-sans text-xs uppercase tracking-[0.3em] mb-4">
							● Contiene gluten
						</p>
						<p class="text-primary/50 font-sans text-xs uppercase tracking-[0.3em] mb-12">
							Todos los postres van acompañados de helado, salvo goxua y sorbete
						</p>
						<div
							class="bg-primary/5 p-12 lg:p-20 relative overflow-hidden group"
						>
							<div
								class="absolute inset-0 bg-primary translate-y-full group-hover:translate-y-0 transition-transform duration-700 ease-out -z-10"
							>
							</div>

							<div class="relative z-10">
								<h3
									class="text-primary group-hover:text-white font-heading text-3xl md:text-4xl mb-8 transition-colors duration-500"
								>
									¿Desea asegurar su mesa?
								</h3>
								<Button
									href="/reservas"
									variant="ghost"
									class="px-12 py-4 border border-primary/20 group-hover:border-white/40 text-primary group-hover:text-white transition-all duration-500"
								>
									RESERVAR AHORA
								</Button>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>
	</main>

	<Footer />

	<!-- Reveal Animation Script -->
	<script is:inline>
		const observerOptions = { threshold: 0.1 };
		const observer = new IntersectionObserver((entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting) {
					entry.target.classList.add("visible");
				}
			});
		}, observerOptions);

		document
			.querySelectorAll(".reveal-on-scroll")
			.forEach((el) => observer.observe(el));
	</script>
</Layout>
