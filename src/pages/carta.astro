				price: "21,50€",
				desc: "",
			},
			{
				name: "Saquitos fritos de morcilla y manzana asada sobre crema de piquillos. 6uds",
				price: "21€ / 11,50€",
				desc: "",
			},
			{
				name: "*Pulpo a la brasa con parmentier, AOVE, y pimentón de la Vera.",
				price: "19,50€ / 11€",
				desc: "",
			},
			{
				name: "Lecherillas empanadas y fritas con alegría riojana.",
				price: "18,50€ / 10,50€",
				desc: "",
			},
			{
				name: "*Arroz meloso de boletus y carrilleras ibéricas con virutas de parmesano.",
