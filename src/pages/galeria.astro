---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
---

<Layout title="Galería | La Chata 1821">
  <Header />
  <main class="pt-20">
    <div class="py-12 text-center">
      <h1 class="font-heading text-5xl text-primary">Galería</h1>
    </div>
    
    <div class="max-w-7xl mx-auto px-4 pb-20">
      <div class="columns-1 md:columns-2 lg:columns-3 gap-4 space-y-4">
        {[1, 2, 3, 4, 5, 6, 7, 8, 9].map((i) => (
          <div class="break-inside-avoid rounded-lg overflow-hidden group relative">
             <div class="bg-gray-200 aspect-square md:aspect-video lg:aspect-[3/4] flex items-center justify-center text-gray-400 group-hover:bg-gray-300 transition-colors">
                <span class="font-heading text-lg">Foto {i}</span>
             </div>
             <!-- In real implementation, these would be `img` tags -->
             <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors duration-300"></div>
          </div>
        ))}
      </div>
    </div>
  </main>
  <Footer />
</Layout>
