---
import Layout from "../layouts/Layout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
---

<Layout title="Contacto | La Chata 1821">
	<Header />

	<main class="bg-secondary pt-32">
		<!-- Contact Hero -->
		<section class="editorial-container py-24">
			<div class="max-w-4xl reveal-on-scroll">
				<span
					class="text-primary/40 font-sans text-xs uppercase tracking-[0.4em] mb-6 block"
					>En el corazón de la ciudad</span
				>
				<h1
					class="text-primary font-heading text-6xl md:text-8xl leading-none mb-8"
				>
					Contacto y <br />
					<span class="italic font-normal ml-[0.5em] md:ml-[1em]"
						>ubicación</span
					>
				</h1>
			</div>
		</section>

		<!-- Contact Grid -->
		<section class="pb-32">
			<div class="editorial-container">
				<div class="grid lg:grid-cols-12 gap-20 items-start">
					<!-- Info Column -->
					<div class="lg:col-span-4 space-y-16 reveal-on-scroll">
						<div>
							<h3
								class="text-primary/40 font-sans text-[10px] uppercase tracking-[0.4em] mb-6"
							>
								El espacio
							</h3>
							<p
								class="text-primary font-heading text-2xl leading-relaxed"
							>
								Calle Carnicerías, 3, bajo<br />
								26001 Logroño, La Rioja
							</p>
						</div>

						<div>
							<h3
								class="text-primary/40 font-sans text-[10px] uppercase tracking-[0.4em] mb-6"
							>
								Hablemos
							</h3>
							<p
								class="text-primary font-heading text-2xl leading-relaxed"
							>
								T. +34 941 25 12 96<br />
								E. hola@lachata1821.com
							</p>
						</div>

						<div>
							<h3
								class="text-primary/40 font-sans text-[10px] uppercase tracking-[0.4em] mb-6"
							>
								Horarios
							</h3>
							<div class="space-y-4">
								<p
									class="text-primary font-sans text-lg leading-relaxed"
								>
									Martes a Jueves<br />
									<span class="text-primary/60"
										>13:30 – 15:30</span
									>
								</p>
								<p
									class="text-primary font-sans text-lg leading-relaxed"
								>
									Viernes a Domingo<br />
									<span class="text-primary/60"
										>13:30 – 16:00</span
									>
								</p>
							</div>
						</div>
					</div>

					<!-- Map Column -->
					<div
						class="lg:col-span-8 reveal-on-scroll"
						style="transition-delay: 0.2s"
					>
						<div class="relative group">
							<div
								class="aspect-video overflow-hidden bg-white shadow-2xl"
							>
								<iframe
									src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2979.997274474776!2d-2.4485549232924483!3d42.468249971168925!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd507a2d427d1a29%3A0xc6360c7923762699!2sC.%20Carnicer%C3%ADas%2C%203%2C%2026001%20Logro%C3%B1o%2C%20La%20Rioja!5e0!3m2!1ses!2ses!4v1709485000000!5m2!1ses!2ses"
									width="100%"
									height="100%"
									style="border:0;"
									allowfullscreen=""
									loading="lazy"
									referrerpolicy="no-referrer-when-downgrade"
									class="grayscale-100 group-hover:grayscale-0 transition-all duration-[1.5s] scale-105 group-hover:scale-100"
								></iframe>
							</div>
							<div
								class="absolute -top-8 -right-8 w-64 h-64 bg-primary/5 -z-10 group-hover:translate-x-4 group-hover:-translate-y-4 transition-transform duration-1000"
							>
							</div>
						</div>

						<div class="mt-12 text-right">
							<a
								href="https://www.google.com/maps/search/La+Chata+1821+Logro%C3%B1o+Calle+Carnicer%C3%ADas,+3"
								target="_blank"
								class="inline-block text-primary font-sans text-xs uppercase tracking-[0.4em] border-b border-primary/20 pb-2 hover:border-primary transition-colors"
							>
								Abrir en Google Maps &rarr;
							</a>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Atmosphere Section -->
		<section class="pb-32 reveal-on-scroll">
			<div class="editorial-container">
				<div class="aspect-21/9 overflow-hidden shadow-2xl">
					<img
						src="https://images.unsplash.com/photo-1559339352-11d035aa65de?q=80&w=1974&auto=format&fit=crop"
						alt="Interior del restaurante"
						class="w-full h-full object-cover grayscale-20 hover:grayscale-0 transition-all duration-[2.5s]"
					/>
				</div>
			</div>
		</section>
	</main>

	<Footer />

	<!-- Reveal Animation Script -->
	<script is:inline>
		const observerOptions = { threshold: 0.1 };
		const observer = new IntersectionObserver((entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting) {
					entry.target.classList.add("visible");
				}
			});
		}, observerOptions);

		document
			.querySelectorAll(".reveal-on-scroll")
			.forEach((el) => observer.observe(el));
	</script>
</Layout>
