---
import Layout from "../layouts/Layout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import { Picture } from "astro:assets";
import fachadaImg from "../assets/restaurante/IMG_7245.webp";
import productoImg from "../assets/platos/IMG_7167.webp";
import cavaImg from "../assets/restaurante/IMG_0964.webp";
---

<Layout title="Nuestra Historia | La Chata 1821">
	<Header />

	<main class="bg-secondary pt-32">
		<!-- Hero Section -->
		<section class="editorial-container py-24">
			<div class="max-w-4xl">
				<span
					class="text-primary/40 font-sans text-xs uppercase tracking-[0.4em] mb-6 block reveal-on-scroll"
					>La Herencia</span
				>
				<h1
					class="text-primary font-heading text-6xl md:text-9xl leading-[0.85] mb-12 reveal-on-scroll"
					style="transition-delay: 0.1s"
				>
					Historia <br />
					<span class="italic font-normal ml-[0.5em] md:ml-[1em]">viva</span>
				</h1>
			</div>
		</section>

		<!-- Asymmetric Image & Introduction -->
		<section class="editorial-container pb-32">
			<div class="grid lg:grid-cols-12 gap-12 items-start">
				<div class="lg:col-span-7 reveal-on-scroll">
					<div class="relative group">
						<div
							class="absolute -inset-4 border border-primary/5 -z-10 group-hover:-inset-6 transition-all duration-1000"
						>
						</div>
						<div class="aspect-4/5 overflow-hidden bg-white shadow-2xl">
							<Picture
								src={fachadaImg}
								alt="Fachada histórica y ambiente"
								formats={["avif", "webp"]}
								fallbackFormat="webp"
								widths={[900, 1400]}
								sizes="(min-width: 1024px) 60vw, 100vw"
								pictureAttributes={{ class: "w-full h-full" }}
								class="w-full h-full object-cover grayscale-20 group-hover:grayscale-0 transition-all duration-[2s] group-hover:scale-105"
							/>
						</div>
					</div>
				</div>

				<div
					class="lg:col-span-5 lg:pt-24 reveal-on-scroll"
					style="transition-delay: 0.2s"
				>
					<div class="max-w-md">
						<p class="text-primary font-heading text-3xl mb-12 leading-tight">
							La Chata vuelve a la vida un lustro después, manteniendo el fuego
							sagrado de la tradición desde 1821.
						</p>
						<div
							class="space-y-8 text-primary/70 font-sans text-lg leading-relaxed"
						>
							<p>
								Lo hacemos con la ilusión de una nueva dirección, pero sin dejar
								atrás ni un ápice de la honestidad a la que obliga un espacio
								como este, en el corazón latente de Logroño.
							</p>
							<p>
								Ponemos en marcha este templo de la cocina tradicional riojana.
								En nuestras mesas se han sentado generaciones, compartiendo no
								solo comida, sino historias que hoy forman parte de nuestro
								patrimonio.
							</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Quote Section -->
		<section class="bg-primary py-32 overflow-hidden">
			<div class="editorial-container">
				<div class="max-w-4xl mx-auto text-center reveal-on-scroll">
					<div class="w-12 h-px bg-white/20 mx-auto mb-12"></div>
					<h2
						class="text-secondary font-heading text-4xl md:text-6xl italic leading-tight"
					>
						"Uno de esos rincones a los que acudir para resguardarse del frío al
						calor de unas buenas patatas con chorizo."
					</h2>
					<div class="w-12 h-px bg-white/20 mx-auto mt-12"></div>
				</div>
			</div>
		</section>

		<!-- Second Narrative Block -->
		<section class="editorial-container py-32">
			<div class="grid lg:grid-cols-12 gap-12 items-center">
				<div class="lg:col-span-5 reveal-on-scroll">
					<h3 class="text-primary font-heading text-5xl mb-8">
						Nuestra Filosofía
					</h3>
					<div
						class="space-y-6 text-primary/60 font-sans text-lg leading-relaxed max-w-sm"
					>
						<p>
							Respeto absoluto al producto y a la memoria del paladar. En La
							Chata 1821 recuperamos lo bueno: caparrones de profundidad,
							chuletillas al sarmiento y pescados que saben a mar.
						</p>
						<p>
							No buscamos inventar, sino honrar lo que ha funcionado durante
							siglos. El sabor del hogar trasladado a la mesa de Carnicerías 3.
						</p>
					</div>
				</div>

				<div
					class="lg:col-span-7 reveal-on-scroll"
					style="transition-delay: 0.2s"
				>
					<div class="grid grid-cols-2 gap-4">
						<div class="aspect-3/4 overflow-hidden bg-white translate-y-12">
							<Picture
								src={productoImg}
								alt="Productos de la tierra"
								formats={["avif", "webp"]}
								fallbackFormat="webp"
								widths={[500, 800]}
								sizes="(min-width: 1024px) 28vw, 50vw"
								pictureAttributes={{ class: "w-full h-full" }}
								class="w-full h-full object-cover hover:scale-110 transition-transform duration-[2s]"
							/>
						</div>
						<div class="aspect-3/4 overflow-hidden bg-white">
							<Picture
								src={cavaImg}
								alt="Cava y vinos"
								formats={["avif", "webp"]}
								fallbackFormat="webp"
								widths={[500, 800]}
								sizes="(min-width: 1024px) 28vw, 50vw"
								pictureAttributes={{ class: "w-full h-full" }}
								class="w-full h-full object-cover hover:scale-110 transition-transform duration-[2s]"
							/>
						</div>
					</div>
				</div>
			</div>
		</section>
	</main>

	<Footer />

	<!-- Simple Reveal Animation Script (same as index for consistency) -->
	<script is:inline>
		const observerOptions = { threshold: 0.1 };
		const observer = new IntersectionObserver((entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting) {
					entry.target.classList.add("visible");
				}
			});
		}, observerOptions);

		document
			.querySelectorAll(".reveal-on-scroll")
			.forEach((el) => observer.observe(el));
	</script>
</Layout>
