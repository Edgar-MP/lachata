---
import Layout from "../layouts/Layout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Hero from "../components/sections/Hero.astro";
import ReservationWidget from "../components/sections/ReservationWidget.astro";
import Button from "../components/base/Button.astro";
import { Picture } from "astro:assets";
import corazonRiojano from "../assets/corazon-riojano.webp";
import pulpo from "../assets/pulpo.webp";
import chuletillas from "../assets/platos/IMG_9166.webp";
import bacalaoRiojana from "../assets/platos/IMG_7148.webp";
import carrilleras from "../assets/platos/carrilleras.webp";
---

<Layout title="La Chata 1821 | Templo de la Cocina Riojana">
	<Header />

	<main class="overflow-x-hidden">
		<Hero />

		<!-- Editorial About Section -->
		<section class="py-32 bg-white relative">
			<div class="editorial-container">
				<div class="grid lg:grid-cols-2 gap-24 items-center">
					<div class="relative max-w-lg reveal-on-scroll">
						<span
							class="text-primary/40 font-sans text-xs uppercase tracking-[0.4em] mb-6 block"
							>La Herencia</span
						>
						<h2
							class="text-primary font-heading text-6xl md:text-7xl leading-none mb-10"
						>
							Corazón <br /><span class="italic font-normal ml-8"
								>Riojano</span
							>
						</h2>
						<div
							class="space-y-8 text-primary/80 font-sans leading-relaxed text-lg"
						>
							<p>
								La Chata vuelve a ser uno de esos rincones -al
								principio un tanto secretos- a los que acudir
								para resguardarse del frío al calor de unas
								buenas patatas con chorizo o unos caparrones de
								profundidad.
							</p>
							<p>
								Tras un lustro de silencio, este espacio que ha
								alimentado a Logroño desde 1821 vuelve con una
								nueva dirección, pero con el mismo respeto
								sagrado por la tradición.
							</p>
						</div>

						<div class="mt-12">
							<a
								href="/nosotros"
								class="group flex items-center gap-4 text-primary font-sans text-xs uppercase tracking-[0.3em] font-bold"
							>
								Descubra nuestra historia
								<span
									class="w-12 h-px bg-primary group-hover:w-20 transition-all duration-500"
								></span>
							</a>
						</div>
					</div>

					<div
						class="relative reveal-on-scroll"
						style="transition-delay: 0.2s"
					>
						<div
							class="aspect-[4/5] overflow-hidden bg-secondary relative"
						>
							<Picture
								src={corazonRiojano}
								alt="Corazón riojano"
								formats={["avif", "webp"]}
								fallbackFormat="webp"
								widths={[800, 1200]}
								sizes="(min-width: 1024px) 50vw, 100vw"
								pictureAttributes={{ class: "w-full h-full" }}
								class="w-full h-full object-cover transform hover:scale-110 transition-transform duration-[2s]"
							/>
							<!-- Decorative floating text -->
							<div
								class="absolute bottom-12 -right-12 lg:-right-24 hidden lg:block"
							>
								<span
									class="text-[clamp(2rem,6vw,5rem)] font-heading text-primary/10 whitespace-nowrap select-none"
									>PRODUCTO DE MERCADO</span
								>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Full-impact Quote Section -->
		<section
			class="py-40 bg-secondary/30 text-center border-y border-primary/5"
		>
			<div class="editorial-container max-w-4xl">
				<blockquote
					class="text-primary/90 font-heading text-4xl md:text-6xl leading-[1.1] mb-12"
				>
					"Un templo de <span class="italic font-normal"
						>cocina tradicional</span
					> donde el tiempo se detiene ante unas chuletillas de toda la
					vida."
				</blockquote>
				<span
					class="text-primary/40 font-sans text-[10px] uppercase tracking-[0.6em]"
					>La Chata 1821</span
				>
			</div>
		</section>

		<!-- Editorial Menu Highlight -->
		<section class="py-32 bg-white">
			<div class="editorial-container">
				<div
					class="flex flex-col md:flex-row justify-between items-end mb-24 gap-8"
				>
					<div class="reveal-on-scroll">
						<span
							class="text-primary/40 font-sans text-xs uppercase tracking-[0.4em] mb-4 block"
							>La Selección</span
						>
						<h2
							class="text-primary font-heading text-6xl md:text-8xl leading-none"
						>
							La Carta
						</h2>
					</div>
					<div
						class="reveal-on-scroll"
						style="transition-delay: 0.2s"
					>
						<a
							href="/carta"
							class="group flex items-center gap-4 text-primary/60 hover:text-primary transition-colors font-sans text-xs uppercase tracking-widest border-b border-primary/10 pb-2"
						>
							Ver carta completa
							<svg
								class="w-4 h-4 transform group-hover:translate-x-1 transition-transform"
								fill="none"
								stroke="currentColor"
								viewBox="0 0 24 24"
								><path d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg
							>
						</a>
					</div>
				</div>

				<div class="space-y-32">
							{
								[
									{
										title: "Chuletillas de Cordero",
										desc: "A la brasa con patatas baby asadas, pimientos del país y del piquillo.",
										image: chuletillas,
										align: "left",
									},
									{
										title: "Bacalao a la Riojana",
										desc: "Lomo de bacalao sobre salsa de pimiento rojo, como manda la tradición riojana.",
										image: bacalaoRiojana,
										align: "right",
									},
									{
										title: "Carrilleras Ibéricas",
										desc: "Al vino tinto con crema de patata y chips crujientes.",
										image: carrilleras,
										align: "left",
									},
								].map((item, idx) => (
							<article
								class={`grid lg:grid-cols-12 gap-12 items-center reveal-on-scroll`}
								style={`transition-delay: ${idx * 0.1}s`}
							>
								<div
									class={`lg:col-span-7 ${item.align === "right" ? "lg:order-2" : ""}`}
								>
									<div class="relative group overflow-hidden">
										<div class="aspect-video overflow-hidden bg-secondary">
											<Picture
												src={item.image}
												alt={item.title}
												formats={["avif", "webp"]}
												fallbackFormat="webp"
												widths={[900, 1400]}
												sizes="(min-width: 1024px) 60vw, 100vw"
												pictureAttributes={{ class: "w-full h-full" }}
												class="w-full h-full object-cover grayscale-20 group-hover:grayscale-0 transition-all duration-[2s] group-hover:scale-105"
											/>
										</div>
										<div class="absolute -bottom-6 -right-6 w-32 h-32 bg-primary/5 -z-10 transition-transform group-hover:translate-x-4 group-hover:translate-y-4 duration-1000" />
									</div>
								</div>

								<div
									class={`lg:col-span-5 ${item.align === "right" ? "lg:order-1" : ""}`}
								>
									<div
										class={`max-w-sm ${item.align === "right" ? "ml-auto text-right" : ""}`}
									>
										<span class="text-primary/20 font-heading text-6xl block mb-6">
											0{idx + 1}
										</span>
										<h3 class="text-primary font-heading text-4xl mb-6">
											{item.title}
										</h3>
										<p class="text-primary/60 font-sans text-lg leading-relaxed mb-8">
											{item.desc}
										</p>
										<div
											class={`w-12 h-px bg-primary/20 ${item.align === "right" ? "ml-auto" : ""}`}
										/>
									</div>
								</div>
							</article>
						))
					}
				</div>

				<!-- Final Menu CTA -->
				<div class="mt-32 text-center reveal-on-scroll">
					<Button
						href="/carta"
						variant="ghost"
						class="px-16 py-5 border border-primary/20 hover:border-primary text-primary hover:bg-primary/5"
					>
						VER CARTA COMPLETA
					</Button>
				</div>
			</div>
		</section>

		<ReservationWidget />

		<!-- Editorial Location Section (Map Integrated) -->
		<section
			class="bg-white py-32 overflow-hidden border-t border-primary/5"
		>
			<div class="editorial-container">
				<div class="grid lg:grid-cols-12 gap-20 items-center">
					<!-- Map Column -->
					<div class="lg:col-span-7 reveal-on-scroll">
						<div class="relative group">
							<div
								class="aspect-16/10 overflow-hidden bg-secondary relative transition-transform duration-1000 group-hover:-translate-y-1 group-hover:translate-x-1 shadow-2xl"
							>
								<div
									class="absolute inset-0 bg-primary/10 group-hover:bg-primary/0 transition-all duration-1000 z-10 pointer-events-none"
								>
								</div>
								<iframe
									src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2979.997274474776!2d-2.4485549232924483!3d42.468249971168925!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd507a2d427d1a29%3A0xc6360c7923762699!2sC.%20Carnicer%C3%ADas%2C%203%2C%2026001%20Logro%C3%B1o%2C%20La%20Rioja!5e0!3m2!1ses!2ses!4v1709485000000!5m2!1ses!2ses"
									width="100%"
									height="100%"
									style="border:0;"
									allowfullscreen=""
									loading="lazy"
									referrerpolicy="no-referrer-when-downgrade"
									class="grayscale group-hover:grayscale-0 group-hover:scale-105 transition-all duration-1000 transform"
								></iframe>
							</div>
							<div
								class="absolute -bottom-8 -right-8 w-48 h-48 bg-primary/5 -z-10 transition-transform group-hover:translate-x-3 group-hover:translate-y-3 duration-1000"
							>
							</div>
						</div>
					</div>

					<!-- Info Column -->
					<div
						class="lg:col-span-5 reveal-on-scroll"
						style="transition-delay: 0.2s"
					>
						<span
							class="text-primary/40 font-sans text-xs uppercase tracking-[0.4em] mb-6 block"
							>Encuéntranos</span
						>
						<h2
							class="text-primary font-heading text-6xl leading-none mb-6"
						>
							Corazón de <br /><span
								class="italic font-normal ml-8">Logroño</span
							>
						</h2>

						<p
							class="text-primary/60 font-sans text-sm leading-relaxed mb-10 max-w-sm"
						>
							Ubicados en el histórico edificio de 1821, somos un
							refugio de sabor riojano a pocos pasos de la
							emblemática Calle Laurel.
						</p>

						<div class="space-y-10">
							<div class="border-l-2 border-primary/10 pl-8">
								<h3
									class="text-primary font-sans text-xs uppercase tracking-widest font-bold mb-3"
								>
									Dirección
								</h3>
								<p
									class="text-primary/80 font-sans text-xl leading-relaxed"
								>
									C. Carnicerías, 3, bajo<br />
									26001 Logroño, La Rioja
								</p>
							</div>

							<div class="border-l-2 border-primary/10 pl-8">
								<h3
									class="text-primary font-sans text-xs uppercase tracking-widest font-bold mb-3"
								>
									Horario de Comidas
								</h3>
								<p
									class="text-primary/80 font-sans text-sm uppercase tracking-wider"
								>
									Cerrado lunes y martes<br />
									Miércoles a Jueves: 13:30 – 15:30<br />
									Viernes a Domingo: 13:30 – 16:00<br />
									Noches: bajo reserva para grupos a partir de 10 personas
								</p>
							</div>
						</div>

						<div class="mt-16">
							<a
								href="https://www.google.com/maps/search/La+Chata+1821+Logro%C3%B1o+Calle+Carnicer%C3%ADas,+3"
								target="_blank"
								class="inline-block bg-primary text-secondary px-10 py-4 font-sans font-bold text-xs tracking-widest transition-all hover:bg-primary-dark shadow-xl hover:-translate-y-1 active:scale-95"
							>
								CÓMO LLEGAR
							</a>
						</div>
					</div>
				</div>
			</div>
		</section>
	</main>

	<Footer />
</Layout>

<script is:inline>
	// Simple Reveal Animation
	const observerOptions = {
		threshold: 0.1,
	};

	const observer = new IntersectionObserver((entries) => {
		entries.forEach((entry) => {
			if (entry.isIntersecting) {
				entry.target.classList.add("visible");
			}
		});
	}, observerOptions);

	document
		.querySelectorAll(".reveal-on-scroll")
		.forEach((el) => observer.observe(el));
</script>
