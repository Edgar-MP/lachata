---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import ReservationWidget from '../components/sections/ReservationWidget.astro';
---

<Layout title="Reservas | La Chata 1821">
  <Header />
  <main class="pt-20">
    <div class="bg-primary py-12 text-center text-white">
      <h1 class="font-heading text-5xl">Reservas</h1>
      <p class="mt-4 text-white/80 max-w-2xl mx-auto px-4">
        Disfrute de la auténtica cocina riojana. Recomendamos reservar con antelación para fines de semana.
      </p>
    </div>
    <ReservationWidget />
  </main>
  <Footer />
</Layout>
