---

---

<div
	id="access-gate"
	class="fixed inset-0 z-9999 bg-primary flex items-center justify-center transition-all duration-1000 ease-in-out invisible opacity-0"
>
	<div class="max-w-md w-full px-8 text-center space-y-12">
		<div class="space-y-4">
			<span
				class="text-secondary/40 font-sans text-xs uppercase tracking-[0.4em] block"
				>Acceso Privado</span
			>
			<h2 class="text-secondary font-heading text-4xl md:text-5xl">
				La Chata 1821
			</h2>
			<p class="text-secondary/60 font-sans text-sm leading-relaxed">
				Esta es una versión en desarrollo. Por favor, introduzca el
				código de acceso para continuar.
			</p>
		</div>

		<div class="space-y-6">
			<div class="relative">
				<input
					type="password"
					id="access-code"
					placeholder="Código de acceso"
					class="w-full bg-transparent border-b border-secondary/20 py-4 px-2 text-secondary text-center font-heading text-2xl focus:outline-none focus:border-secondary transition-colors placeholder:text-secondary/10"
				/>
			</div>

			<button
				id="check-access"
				class="w-full bg-secondary text-primary px-8 py-4 text-[10px] uppercase tracking-[0.3em] font-bold hover:bg-white transition-all duration-500 shadow-xl"
			>
				Entrar al Sitio
			</button>

			<p
				id="access-error"
				class="text-accent text-[10px] uppercase tracking-widest opacity-0 transition-opacity duration-300"
			>
				Código incorrecto. Inténtelo de nuevo.
			</p>
		</div>
	</div>
</div>

<style>
	#access-gate.visible {
		visibility: visible;
		opacity: 1;
	}
</style>

<script>
	function initAccessGate() {
		const gate = document.getElementById("access-gate");
		const input = document.getElementById(
			"access-code",
		) as HTMLInputElement;
		const button = document.getElementById("check-access");
		const error = document.getElementById("access-error");

		// THE CODE (A more secure random code for private review)
		const SECRET_CODE = "K8P2R5";

		if (!gate) return;

		// Check if already authenticated during session
		if (sessionStorage.getItem("site-access") === "granted") {
			gate.remove(); // Direct removal if already granted
			return;
		}

		// Show gate if not granted
		gate.classList.add("visible");

		function handleAccess() {
			if (input.value === SECRET_CODE) {
				sessionStorage.setItem("site-access", "granted");
				gate?.classList.remove("visible");
				setTimeout(() => gate?.remove(), 1000);
			} else {
				error?.classList.remove("opacity-0");
				input.value = "";
				input.focus();
				setTimeout(() => error?.classList.add("opacity-0"), 3000);
			}
		}

		button?.addEventListener("click", handleAccess);
		input?.addEventListener("keypress", (e) => {
			if (e.key === "Enter") handleAccess();
		});
	}

	initAccessGate();
	document.addEventListener("astro:after-swap", initAccessGate);
</script>
