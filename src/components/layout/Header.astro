---
import { Image } from "astro:assets";
import logoWordmark from "../../assets/logo/la-chata-logo-wordmark.png";

const navItems = [
	{ label: "Carta", href: "/carta" },
	{ label: "Vinos", href: "/vinos" },
	{ label: "Nosotros", href: "/nosotros" },
	{ label: "Galería", href: "/galeria" },
	{ label: "Contacto", href: "/contacto" },
];
---

<header
	id="main-header"
	class="fixed w-full top-0 z-100 transition-all duration-700 py-10"
>
	<div class="editorial-container">
		<div class="flex justify-between items-center">
			<!-- Left Side: Brand & Motto -->
			<div class="flex items-center gap-8">
				<a href="/" class="group">
					<Image
						src={logoWordmark}
						alt="La Chata 1821"
						class="h-10 w-auto transition-all duration-700"
						id="header-logo"
						loading="eager"
						fetchpriority="high"
					/>
				</a>
				<div class="hidden xl:block h-6 w-px bg-primary/20"></div>
				<div class="hidden xl:block overflow-hidden">
					<span
						class="block text-[9px] uppercase tracking-[0.4em] text-primary/40 animate-fade-up">
						Desde 1821 &bull; Logroño
					</span>
				</div>
			</div>

			<!-- Right Side: Navigation & CTA -->
			<div class="flex items-center space-x-16">
				<nav class="hidden lg:flex space-x-12 items-center">
					{
						navItems.map((item) => (
							<a
								href={item.href}
								class="nav-link text-primary/60 hover:text-primary transition-all duration-300 font-sans text-[10px] uppercase tracking-[0.3em]"
							>
								{item.label}
							</a>
						))
					}
				</nav>

				<div class="flex items-center gap-8">
					<a
						href="/reservas"
						class="group relative hidden md:inline-block border border-primary px-8 py-3 text-primary font-sans text-[10px] font-bold tracking-[0.3em] uppercase transition-all duration-500 hover:bg-primary hover:text-white"
					>
						<span class="relative z-10">RESERVAR</span>
						<div
							class="absolute -top-1 -right-1 w-2 h-2 border-t border-r border-primary/40 group-hover:border-white transition-colors"
						>
						</div>
					</a>

					<!-- Minimal Mobile Toggle -->
					<button
						id="mobile-menu-toggle"
						class="lg:hidden flex flex-col gap-1.5 focus:outline-none group z-100"
						aria-label="Abrir menú"
					>
						<span
							class="w-8 h-px bg-primary transition-all duration-500 origin-center middle-bar"
						></span>
						<span
							class="w-5 h-px bg-primary self-end transition-all duration-500 origin-center bottom-bar"
						></span>
					</button>
				</div>
			</div>
		</div>
	</div>
</header>

<!-- Premium Mobile Menu Overlay (Outside header to avoid transform/padding issues) -->
<div
	id="mobile-menu"
	class="fixed inset-0 bg-secondary translate-x-full transition-transform duration-700 ease-[cubic-bezier(0.85,0,0.15,1)] z-90 flex flex-col justify-center px-12"
>
	<nav class="flex flex-col space-y-8">
		{
			navItems.map((item, idx) => (
				<a
					href={item.href}
					class="mobile-nav-link opacity-0 translate-y-8 text-primary font-heading text-5xl italic transition-all"
					style={`transition-delay: ${0.2 + idx * 0.1}s`}
				>
					{item.label}
				</a>
			))
		}
		<div
			class="h-px w-12 bg-primary/20 my-8 opacity-0 mobile-nav-link"
			style="transition-delay: 0.6s"
		>
		</div>
		<a
			href="/reservas"
			class="mobile-nav-link opacity-0 translate-y-8 text-primary font-sans text-xs uppercase tracking-[0.4em] font-bold"
			style="transition-delay: 0.7s"
		>
			Reservar Mesa
		</a>
	</nav>

	<!-- Mobile Header Footer Detail -->
	<div
		class="absolute bottom-12 left-12 opacity-0 mobile-nav-link"
		style="transition-delay: 0.8s"
	>
		<span
			class="block text-primary/30 font-sans text-[9px] uppercase tracking-[0.4em] mb-4"
			>Ubicación</span
		>
		<p
			class="text-primary font-sans text-xs uppercase tracking-widest leading-relaxed"
		>
			C. Carnicerías 3<br />
			Logroño, La Rioja
		</p>
	</div>
</div>

<script is:inline>
	const header = document.getElementById("main-header");
	const toggle = document.getElementById("mobile-menu-toggle");
	const menu = document.getElementById("mobile-menu");
	const middleBar = toggle?.querySelector(".middle-bar");
	const bottomBar = toggle?.querySelector(".bottom-bar");
	const navLinks = document.querySelectorAll(".mobile-nav-link");

	let isMenuOpen = false;

	function toggleMenu() {
		isMenuOpen = !isMenuOpen;

		if (isMenuOpen) {
			menu.classList.remove("translate-x-full");
			document.body.style.overflow = "hidden";
			header.classList.add("menu-open");
			// Force remove scroll-triggered classes
			header.classList.remove(
				"bg-white/90",
				"backdrop-blur-xl",
				"py-6",
				"shadow-[0_10px_40px_-15px_rgba(92,30,42,0.1)]",
			);
			header.classList.add("py-10");

			middleBar?.classList.add("rotate-45", "translate-y-[4px]", "w-8");
			bottomBar?.classList.add("-rotate-45", "-translate-y-[4px]", "w-8");
			navLinks.forEach((link) => {
				link.classList.add("opacity-100", "translate-y-0");
				link.classList.remove("opacity-0", "translate-y-8");
			});
		} else {
			menu.classList.add("translate-x-full");
			document.body.style.overflow = "auto";
			header.classList.remove("menu-open");

			// Re-apply scroll classes if needed
			if (window.scrollY > 40) {
				header.classList.add(
					"bg-white/90",
					"backdrop-blur-xl",
					"py-6",
					"shadow-[0_10px_40px_-15px_rgba(92,30,42,0.1)]",
				);
				header.classList.remove("py-10");
			}

			middleBar?.classList.remove("rotate-45", "translate-y-[4px]", "w-8");
			bottomBar?.classList.remove("-rotate-45", "-translate-y-[4px]", "w-8");
			navLinks.forEach((link) => {
				link.classList.remove("opacity-100", "translate-y-0");
				link.classList.add("opacity-0", "translate-y-8");
			});
		}
	}

	toggle?.addEventListener("click", toggleMenu);

	window.addEventListener("scroll", () => {
		if (window.scrollY > 40 && !isMenuOpen) {
			header.classList.add(
				"bg-white/90",
				"backdrop-blur-xl",
				"py-6",
				"shadow-[0_10px_40px_-15px_rgba(92,30,42,0.1)]",
			);
			header.classList.remove("py-10");
		} else {
			header.classList.remove(
				"bg-white/90",
				"backdrop-blur-xl",
				"py-6",
				"shadow-[0_10px_40px_-15px_rgba(92,30,42,0.1)]",
			);
			header.classList.add("py-10");
		}
	});

	// Close menu on link click
	navLinks.forEach((link) => {
		link.addEventListener("click", () => {
			if (isMenuOpen) toggleMenu();
		});
	});
</script>

<style>
	.nav-link {
		position: relative;
	}
	.nav-link::before {
		content: "";
		position: absolute;
		top: -12px;
		left: 50%;
		width: 2px;
		height: 2px;
		background-color: var(--color-primary);
		border-radius: 50%;
		opacity: 0;
		transform: translateY(-5px);
		transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
	}
	.nav-link:hover::before {
		opacity: 0.4;
		transform: translateY(0);
	}
</style>
