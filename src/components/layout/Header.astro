---
import Logo from '../base/Logo.astro';

const navItems = [
  { label: 'Carta', href: '/carta' },
  { label: 'Nosotros', href: '/nosotros' },
  { label: 'Galería', href: '/galeria' },
  { label: 'Contacto', href: '/contacto' },
];
---

<header id="main-header" class="fixed w-full top-0 z-50 transition-all duration-500 py-6">
  <div class="editorial-container">
    <div class="flex justify-between items-center">
      <!-- Logo Side -->
      <a href="/" class="z-50">
        <Logo class="h-12 w-auto transition-colors duration-500" id="header-logo" color="#794223" />
      </a>

      <!-- Navigation & CTA -->
      <div class="flex items-center space-x-12">
        <nav class="hidden md:flex space-x-10 items-center">
          {navItems.map((item) => (
            <a 
              href={item.href} 
              class="nav-link text-primary/80 hover:text-primary font-medium transition-colors font-sans text-xs uppercase tracking-[0.2em]"
            >
              {item.label}
            </a>
          ))}
        </nav>

        <a 
          href="/reservas" 
          class="inline-block bg-primary text-white px-8 py-3 rounded-none font-sans font-bold text-xs tracking-[0.15em] transition-all hover:bg-primary-dark shadow-xl active:scale-95"
        >
          RESERVAR
        </a>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  const header = document.getElementById('main-header');
  const logo = document.getElementById('header-logo');
  
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      header.classList.add('bg-white/95', 'backdrop-blur-md', 'py-4', 'shadow-sm');
      header.classList.remove('py-6');
    } else {
      header.classList.remove('bg-white/95', 'backdrop-blur-md', 'py-4', 'shadow-sm');
      header.classList.add('py-6');
    }
  });
</script>

<style>
  .nav-link {
    position: relative;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 1px;
    background-color: currentColor;
    transition: width 0.3s ease;
  }
  .nav-link:hover::after {
    width: 100%;
  }
</style>
