---
---

<section class="relative min-h-screen flex flex-col justify-center overflow-hidden bg-secondary">
  <!-- Subtle Texture Overlay -->
  <div class="absolute inset-0 opacity-[0.03] pointer-events-none bg-[url('https://www.transparenttextures.com/patterns/asfalt-dark.png')]"></div>

  <div class="editorial-container relative z-10 py-32 mt-20">
    <div class="grid lg:grid-cols-12 gap-12 items-end">
      <!-- Big Typography Header -->
      <div class="lg:col-span-8">
        <span class="block text-primary font-sans text-xs uppercase tracking-[0.4em] mb-8 animate-fade-up" style="animation-delay: 0.1s">Desde 1821</span>
        <h1 class="text-primary font-heading leading-[0.9] mb-12 animate-fade-up" style="animation-delay: 0.3s">
          <span class="block text-[clamp(4rem,15vw,12rem)]">Tradición</span>
          <span class="block text-[clamp(3.5rem,13vw,10rem)] italic font-normal ml-[0.5em] md:ml-[1.5em] text-primary/80">en cada bocado</span>
        </h1>
      </div>

      <!-- Hero Image (Asymmetric) -->
      <div class="lg:col-span-4 lg:col-start-9 animate-fade-up" style="animation-delay: 0.5s">
         <div class="relative group">
            <div class="absolute -inset-4 border border-primary/10 -z-10 transition-all group-hover:-inset-6 duration-700"></div>
            <img 
              src="https://images.unsplash.com/photo-1559339352-11d035aa65de?q=80&w=1974&auto=format&fit=crop" 
              alt="Interior La Chata" 
              class="w-full aspect-[3/4] object-cover grayscale-[20%] hover:grayscale-0 transition-all duration-1000"
            />
            <div class="mt-6 flex justify-between items-baseline border-b border-primary/20 pb-4">
              <span class="text-primary font-sans text-xs uppercase tracking-widest italic">C. CARNICERÍAS 3</span>
              <span class="text-primary/50 font-sans text-[10px] uppercase tracking-tighter self-end leading-none">Logroño, La Rioja</span>
            </div>
         </div>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="editorial-container mt-auto pb-12 w-full flex flex-col md:flex-row justify-between items-end gap-8 border-t border-primary/5 pt-8 animate-fade-up" style="animation-delay: 0.7s">
    <p class="max-w-sm text-primary/70 font-sans leading-relaxed text-sm">
      Vuelva a los rincones donde el frío desaparece ante el calor de unas patatas con chorizo y el alma de la cocina riojana.
    </p>
    
    <div class="flex gap-12">
      <div class="flex flex-col gap-1">
        <span class="text-primary/40 font-sans text-[10px] uppercase tracking-widest">Contacto</span>
        <a href="tel:+34667286766" class="text-primary text-sm hover:underline">+34 667 28 67 66</a>
      </div>
      <div class="flex flex-col gap-1">
        <span class="text-primary/40 font-sans text-[10px] uppercase tracking-widest">Horario</span>
        <span class="text-primary text-sm uppercase">Comidas M-D</span>
      </div>
    </div>
  </div>
</section>
