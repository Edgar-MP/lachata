---
interface Props {
  class?: string;
  color?: string;
  id?: string;
  [key: string]: any;
}

const { class: className, color = "currentColor", ...rest } = Astro.props;
---

<svg class={className} viewBox="0 0 300 120" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="La Chata 1821 Logo" {...rest}>
  <!-- Background texture hint (optional, kept simple for now) -->
  
  <!-- "La Chata" -->
  <text x="150" y="60" text-anchor="middle" fill={color} font-family="serif" font-weight="bold" font-size="48" letter-spacing="2">
    La Chata
  </text>
  
  <!-- Separator Line -->
  <line x1="80" y1="75" x2="220" y2="75" stroke={color} stroke-width="1" />
  
  <!-- "Restaurante" -->
  <text x="150" y="95" text-anchor="middle" fill={color} font-family="serif" font-size="14" letter-spacing="4" style="text-transform: uppercase;">
    Restaurante
  </text>
  
  <!-- "1821" -->
  <text x="150" y="115" text-anchor="middle" fill={color} font-family="serif" font-size="12" font-weight="bold" letter-spacing="1">
    EST. 1821
  </text>
</svg>
